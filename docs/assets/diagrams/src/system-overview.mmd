  subgraph auto[Automation and reports]
    direction TB
    n8n[n8n :5678]:::ok
    pj[python-jobs<br/>no published port]:::ok
    rep[(Reports + snapshots)]:::ok
    mcp[MCP server<br/>no published port]:::ok
