{
  "uid": "home-network-overview",
  "title": "NUC host metrics (not whole-home traffic)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "network",
    "host-only"
  ],
  "description": "Explicit host NIC snapshots via textfile collector. Stale NIC data is hidden after 120s. CPU/memory are from the existing node exporter. No packets or LAN discovery.",
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Explicitly selected host NIC",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(lab_host_network_receive_bytes_total, device)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU utilization (%)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{device}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Memory used (%)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "legendFormat": "{{device}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Load (1 minute)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{job=\"node\"}",
          "legendFormat": "{{device}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Host NIC receive (bytes/s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(lab_host_network_receive_bytes_total{job=\"node\",device=~\"$device\"}[5m]) and on(job,instance) (time() - lab_host_network_snapshot_timestamp_seconds{job=\"node\"} < 120)",
          "legendFormat": "{{device}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Host NIC transmit (bytes/s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(lab_host_network_transmit_bytes_total{job=\"node\",device=~\"$device\"}[5m]) and on(job,instance) (time() - lab_host_network_snapshot_timestamp_seconds{job=\"node\"} < 120)",
          "legendFormat": "{{device}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Host snapshot age (seconds; missing = not installed)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - lab_host_network_snapshot_timestamp_seconds{job=\"node\"}",
          "legendFormat": "{{device}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Host NIC errors / drops per second",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate({__name__=~\"lab_host_network_(receive|transmit)_(errors|dropped)_total\",job=\"node\",device=~\"$device\"}[5m]) and on(job,instance) (time() - lab_host_network_snapshot_timestamp_seconds{job=\"node\"} < 120)",
          "legendFormat": "{{device}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ]
}
