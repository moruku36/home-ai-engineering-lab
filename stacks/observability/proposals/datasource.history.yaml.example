# Candidate only: outside active provisioning; signed Infinity 4.1.3 required.
apiVersion: 1
datasources:
  - name: HomeLab history
    uid: homelab-history
    type: yesoreyeram-infinity-datasource
    access: proxy
    isDefault: false
    editable: false
    basicAuth: false
    jsonData:
      auth_method: none
      allowedHosts:
        - http://github-history:8081
      proxy_type: none
      oauthPassThru: false
      allowDangerousHTTPMethods: false
      timeoutInSeconds: 10
      customHealthCheckEnabled: true
      customHealthCheckUrl: http://github-history:8081/healthz
      customHealthCheckUrlOptions:
        method: GET
# No secureJsonData, forwarded cookies, OAuth, token or external endpoint.

