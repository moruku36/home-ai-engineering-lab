            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "未取得・未連携",
                        "color": "gray"
                      },
                      "1": {
                        "text": "取得済み",
                        "color": "green"
                      },
                      "2": {
                        "text": "部分取得",
                        "color": "yellow"
                      },
                      "3": {
                        "text": "古いデータ",
                        "color": "orange"
                      },
                      "4": {
                        "text": "取得失敗",
                        "color": "red"
                      },
                      "5": {
                        "text": "未対応",
                        "color": "gray"
                      },
                      "6": {
                        "text": "キャッシュ日時不明",
                        "color": "orange"
                      },
                      "7": {
                        "text": "オフライン",
                        "color": "gray"
                      },
                      "8": {
                        "text": "キャッシュ古い",
                        "color": "orange"
                      }
                    }
