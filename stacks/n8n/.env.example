# Copy to .env (chmod 600). scripts/phase3-run.sh generates real random values automatically.
N8N_ENCRYPTION_KEY=<64 hex chars: openssl rand -hex 32>
JOBS_TOKEN=<64 hex chars: openssl rand -hex 32>
# Comma-separated owner/repo allowlist for the read-only GitHub job
ALLOWED_REPOS=moruku36/home-ai-engineering-lab
