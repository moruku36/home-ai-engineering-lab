{
  "id": "FwkwmDD4fQ1exM72",
  "name": "GitHub repo metadata (read-only)",
  "nodes": [
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "r1", "name": "repo", "value": "moruku36/home-ai-engineering-lab", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Target repo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-jobs:8080/jobs/github-repo-metadata",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ repo: $json.repo }) }}",
        "options": {
          "timeout": 30000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Run python job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "pjtoken00000001", "name": "python-jobs token" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Job ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, -40]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "summary", "value": "={{ $json.data.full_name + ' | stars ' + $json.data.stars + ' | open issues ' + $json.data.open_issues + ' | pushed ' + $json.data.pushed_at }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, -100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "status", "value": "failed", "type": "string" },
            { "id": "e2", "name": "error", "value": "={{ ($json.error && $json.error.message) || $json.error || 'unknown error' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Error summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 100]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Target repo", "type": "main", "index": 0 }]] },
    "Target repo": { "main": [[{ "node": "Run python job", "type": "main", "index": 0 }]] },
    "Run python job": {
      "main": [
        [{ "node": "Job ok?", "type": "main", "index": 0 }],
        [{ "node": "Error summary", "type": "main", "index": 0 }]
      ]
    },
    "Job ok?": {
      "main": [
        [{ "node": "Summary", "type": "main", "index": 0 }],
        [{ "node": "Error summary", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
