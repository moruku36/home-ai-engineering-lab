{
  "id": "GithubDailyRpt01",
  "name": "GitHub daily report (read-only)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 7 * * *" } ] }
      },
      "id": "c3000000-0000-4000-8000-000000000001",
      "name": "Every day 07:00 JST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, -80]
    },
    {
      "parameters": {},
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-jobs:8080/jobs/github-dev-snapshot",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": { "timeout": 240000, "response": { "response": { "neverError": true } } }
      },
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "Collect GitHub snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 10],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 60000,
      "onError": "continueErrorOutput",
      "credentials": { "httpHeaderAuth": { "id": "pjtoken00000001", "name": "python-jobs token" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "k1", "leftValue": "={{ $json.ok }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Job ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [500, -20]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "status", "value": "ok", "type": "string" },
            { "id": "s2", "name": "report", "value": "={{ $json.report }}", "type": "string" },
            { "id": "s3", "name": "summary", "value": "={{ 'repos ' + $json.counts.repos + ' | open issues ' + $json.counts.issues + ' | open PRs ' + $json.counts.prs + ' | critical ' + $json.counts.critical + ' | warnings ' + $json.counts.warn + ' | API calls ' + $json.counts.api_calls + ($json.partial ? ' | PARTIAL DATA' : '') }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [760, -100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "status", "value": "failed", "type": "string" },
            { "id": "e2", "name": "error", "value": "={{ $json.error ? ($json.error.message || $json.error) : 'unknown error' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000006",
      "name": "Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [760, 100]
    }
  ],
  "connections": {
    "Every day 07:00 JST": { "main": [[{ "node": "Collect GitHub snapshot", "type": "main", "index": 0 }]] },
    "Manual Trigger": { "main": [[{ "node": "Collect GitHub snapshot", "type": "main", "index": 0 }]] },
    "Collect GitHub snapshot": {
      "main": [
        [{ "node": "Job ok?", "type": "main", "index": 0 }],
        [{ "node": "Failure", "type": "main", "index": 0 }]
      ]
    },
    "Job ok?": {
      "main": [
        [{ "node": "Summary", "type": "main", "index": 0 }],
        [{ "node": "Failure", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Tokyo" },
  "active": false
}
